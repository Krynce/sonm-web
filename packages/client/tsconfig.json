{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "vite/client",
      "vite-plugin-solid-svg/types",
      "vite-plugin-pwa/client"
    ],
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@test": ["test"],
      "@sonm/app": ["components/app"],
      "@sonm/app/*": ["components/app/*"],
      "@sonm/auth": ["components/auth"],
      "@sonm/auth/*": ["components/auth/*"],
      "@sonm/client": ["components/client"],
      "@sonm/client/*": ["components/client/*"],
      "@sonm/common": ["components/common"],
      "@sonm/common/*": ["components/common/*"],
      "@sonm/instance": ["components/instance"],
      "@sonm/instance/*": ["components/instance/*"],
      "@sonm/i18n": ["components/i18n"],
      "@sonm/i18n/*": ["components/i18n/*"],
      "@sonm/keybinds": ["components/keybinds"],
      "@sonm/keybinds/*": ["components/keybinds/*"],
      "@sonm/markdown": ["components/markdown"],
      "@sonm/markdown/*": ["components/markdown/*"],
      "@sonm/modal": ["components/modal"],
      "@sonm/modal/*": ["components/modal/*"],
      "@sonm/routing": ["components/routing"],
      "@sonm/routing/*": ["components/routing/*"],
      "@sonm/rtc": ["components/rtc"],
      "@sonm/rtc/*": ["components/rtc/*"],
      "@sonm/state": ["components/state"],
      "@sonm/state/*": ["components/state/*"],
      "@sonm/ui": ["components/ui"],
      "@sonm/ui/*": ["components/ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "types/*.d.ts"
  ],
  "exclude": ["components/i18n/locales/*"]
}
